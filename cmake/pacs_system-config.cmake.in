@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads REQUIRED)
# pacs_encoding publicly links ICU; installed consumers need the same targets.
if(APPLE AND NOT ICU_ROOT)
    execute_process(COMMAND brew --prefix icu4c
        OUTPUT_VARIABLE _pacs_icu_prefix OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_pacs_icu_prefix)
        set(ICU_ROOT "${_pacs_icu_prefix}")
    endif()
endif()
find_package(ICU CONFIG QUIET COMPONENTS uc data)
if(NOT ICU_FOUND)
    find_dependency(ICU REQUIRED COMPONENTS uc data)
endif()
# Published registry ports (0.1.x) install legacy package names; accept them
# after the current names, matching cmake/dependencies.cmake.
macro(_pacs_find_ecosystem_dependency current_name legacy_name)
    find_package(${current_name} CONFIG QUIET)
    if(NOT ${current_name}_FOUND)
        find_dependency(${legacy_name} CONFIG)
    endif()
endmacro()

find_dependency(common_system CONFIG REQUIRED)
_pacs_find_ecosystem_dependency(container_system ContainerSystem)
_pacs_find_ecosystem_dependency(network_system NetworkSystem)

if(@PACS_SYSTEM_WITH_THREAD_SYSTEM@)
    find_dependency(thread_system CONFIG REQUIRED)
endif()

if(@PACS_SYSTEM_WITH_LOGGER_SYSTEM@)
    _pacs_find_ecosystem_dependency(logger_system LoggerSystem)
endif()

if(@PACS_SYSTEM_WITH_MONITORING_SYSTEM@)
    find_dependency(monitoring_system CONFIG REQUIRED)
endif()

if(@PACS_SYSTEM_WITH_DATABASE_SYSTEM@)
    find_dependency(database_system CONFIG REQUIRED)
endif()

if(@PACS_SYSTEM_WITH_SQLITE@)
    find_dependency(SQLite3 REQUIRED)
endif()

if(@PACS_SYSTEM_WITH_JPEG@)
    find_dependency(JPEG REQUIRED)
endif()

if(@PACS_SYSTEM_WITH_JPEG2000@)
    find_dependency(OpenJPEG REQUIRED)
endif()

if(@PACS_SYSTEM_WITH_JPEGLS@)
    find_dependency(charls CONFIG REQUIRED)
endif()

if(@PACS_SYSTEM_WITH_HTJ2K@)
    find_dependency(openjph CONFIG REQUIRED)
endif()

if(@PACS_SYSTEM_WITH_OPENSSL@)
    find_dependency(OpenSSL REQUIRED)
endif()

if(@PACS_SYSTEM_WITH_CROW@)
    find_dependency(Crow CONFIG REQUIRED)
endif()

if(@PACS_SYSTEM_WITH_AWS_SDK@)
    find_dependency(AWSSDK REQUIRED COMPONENTS s3)
endif()

if(@PACS_SYSTEM_WITH_AZURE_SDK@)
    find_dependency(azure-storage-blobs-cpp CONFIG REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/pacs_system-targets.cmake")

@PACS_SYSTEM_BRIDGE_TARGET_SETUP@

# Backward compatibility aliases (kcenon::pacs:: -> pacs_system::)
foreach(_compat_target core encoding network client services security storage ai monitoring workflow web integration)
    if(TARGET pacs_system::${_compat_target} AND NOT TARGET kcenon::pacs::${_compat_target})
        add_library(kcenon::pacs::${_compat_target} ALIAS pacs_system::${_compat_target})
    endif()
endforeach()

# Umbrella alias for the legacy README spelling kcenon::pacs_system.
# pacs_system::pacs_system is the canonical v1.0 target; this alias is
# preserved so downstream consumers that hard-coded the old spelling keep
# building against installed packages.
if(TARGET pacs_system::pacs_system AND NOT TARGET kcenon::pacs_system)
    add_library(kcenon::pacs_system ALIAS pacs_system::pacs_system)
endif()

set(pacs_system_FOUND TRUE)
set(PACS_SYSTEM_FOUND TRUE)

set(pacs_system_VERSION "@PROJECT_VERSION@")
set(PACS_SYSTEM_VERSION "${pacs_system_VERSION}")
set(pacs_system_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(PACS_SYSTEM_INCLUDE_DIRS "${pacs_system_INCLUDE_DIRS}")

# Canonical aggregate target for v1.0 consumers.
set(pacs_system_LIBRARIES pacs_system::pacs_system)
set(PACS_SYSTEM_LIBRARIES "${pacs_system_LIBRARIES}")

# Component list for fine-grained linking (kept for backward compatibility).
set(pacs_system_COMPONENT_LIBRARIES
    pacs_system::core
    pacs_system::encoding
    pacs_system::network
    pacs_system::client
    pacs_system::services
    pacs_system::security
)

foreach(_optional_target storage ai monitoring workflow web integration)
    if(TARGET pacs_system::${_optional_target})
        list(APPEND pacs_system_COMPONENT_LIBRARIES pacs_system::${_optional_target})
    endif()
endforeach()

set(PACS_SYSTEM_COMPONENT_LIBRARIES "${pacs_system_COMPONENT_LIBRARIES}")

check_required_components(pacs_system)
