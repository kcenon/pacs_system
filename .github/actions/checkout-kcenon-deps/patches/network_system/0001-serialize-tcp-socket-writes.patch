+
+auto tcp_socket::fail_queued_writes(std::error_code ec) -> void
+{
+    while (!write_queue_.empty())
+    {
+        auto item = std::move(write_queue_.front());
+        write_queue_.pop_front();
+        pending_bytes_.fetch_sub(item.size);
+        metrics_.current_pending_bytes.store(pending_bytes_.load());
+        if (*item.handler)
+        {
+            (*item.handler)(ec, 0);
+        }
+    }
+    write_in_progress_ = false;
+}
+
+auto tcp_socket::start_next_write() -> void
+{
+    if (is_closed_.load() || !socket_.is_open() || socket_.native_handle() == -1)
+    {
+        fail_queued_writes(asio::error::not_connected);
+        return;
+    }
+    auto self = shared_from_this();
+    const auto buffer = write_queue_.front().buffer;
+    const auto data_size = write_queue_.front().size;
+    const auto handler_ptr = write_queue_.front().handler;
